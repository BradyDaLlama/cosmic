# Copy to .env.local (git-ignored) and fill in. Next.js reads it on start.

# Google Cloud → Google Auth Platform → Clients → your Web client.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the session cookie. Any random string of 32+ characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Google accounts allowed to sign in, comma-separated.
ALLOWED_EMAILS=

# "http" uses your real Google Tasks through /api; leave unset for the in-browser demo data.
NEXT_PUBLIC_TASKS_BACKEND=http

# Only for the Android app later: where the deployed API lives. Leave empty on the web.
NEXT_PUBLIC_API_URL=

# The pngtuber shown on Today (an iframe driven with postMessage). Defaults to https://png.bradydallama.com/.
# May include the site's query options, e.g. https://png.bradydallama.com/?outfits=headphones
# Public (NEXT_PUBLIC_), so it's baked in at build time: redeploy after changing it.
NEXT_PUBLIC_PNGTUBER_URL=

# MongoDB Atlas, for Cosmic's own data (settings, then habits, goals and budgets).
# Atlas → Connect → Drivers gives the connection string; use the `cosmic` database user.
# Keep it on one line, e.g. mongodb+srv://cosmic:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name; defaults to "cosmic".
MONGODB_DB=cosmic

# Plaid, for Budget (bank accounts and transactions). dashboard.plaid.com → Developers → Keys.
# Sandbox and Production have different secrets; use the one matching PLAID_ENV.
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" (fake banks, log in with user_good / pass_good) or "production" (real banks).
PLAID_ENV=sandbox
# Where Link sends you back after an OAuth bank (Chase, Capital One...). Must be https and listed in
# dashboard.plaid.com → Developers → API → Allowed redirect URIs, e.g. https://<your-app>.vercel.app/budget.
# Leave empty on localhost: non-OAuth banks and Sandbox's non-OAuth test banks work without it.
PLAID_REDIRECT_URI=
# Public https URL of /api/budget/plaid/webhook, e.g. https://<your-app>.vercel.app/api/budget/plaid/webhook.
# Leave empty on localhost (Plaid can't reach it); Sync now still works.
PLAID_WEBHOOK_URL=
# Encrypts Plaid access tokens (AES-256-GCM) before they're stored in MongoDB. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored tokens unreadable, so every bank would need linking again.
PLAID_TOKEN_KEY=

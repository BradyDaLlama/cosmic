# Copy to .env.local (git-ignored) and fill in. Next.js reads it on start.

# Google Cloud → Google Auth Platform → Clients → your Web client.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the session cookie. Any random string of 32+ characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Google accounts allowed to sign in, comma-separated.
ALLOWED_EMAILS=

# "http" uses your real Google Tasks through /api; leave unset for the in-browser demo data.
NEXT_PUBLIC_TASKS_BACKEND=http

# The pngtuber shown on Today (an iframe driven with postMessage). Defaults to https://png.bradydallama.com/.
# May include the site's query options, e.g. https://png.bradydallama.com/?outfits=headphones
# Public (NEXT_PUBLIC_), so it's baked in at build time: redeploy after changing it.
NEXT_PUBLIC_PNGTUBER_URL=

# MongoDB Atlas, for Cosmic's own data (settings, then habits, goals and routines).
# Atlas → Connect → Drivers gives the connection string; use the `cosmic` database user.
# Keep it on one line, e.g. mongodb+srv://cosmic:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name; defaults to "cosmic".
MONGODB_DB=cosmic

# Optional: an OpenAI-compatible model server (Ollama, llama-server) that writes the Today briefing.
# Leave AI_BASE_URL empty to keep the plain briefing. Include /v1, e.g. http://127.0.0.1:11434/v1 for local Ollama.
AI_BASE_URL=
AI_API_KEY=
# e.g. qwen3:4b-instruct-2507-q4_K_M. On a CPU, a standard instruct model answers fastest: it reuses the
# unchanged system prompt between requests, which hybrid models like qwen3.5 can't.
AI_MODEL=
# Milliseconds; defaults to 60000.
AI_TIMEOUT_MS=
# Defaults to "none" (thinking off). "default" leaves the field out for servers that reject it.
AI_REASONING_EFFORT=
